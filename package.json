{
  "name": "umpforthetest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api-server.mjs",
    "dev:vercel": "vercel dev --listen 3000",
    "dev:full": "concurrently -k -n api,vite -c magenta,blue \"npm run dev:api\" \"vite\"",
    "setup:env": "node -e \"const fs=require('fs');const p='.env.local';if(fs.existsSync(p)){console.log(p+' already exists');process.exit(0)}fs.copyFileSync('.env.example',p);console.log('Created '+p+' — add SUPABASE_SERVICE_ROLE_KEY and restart dev:full');\"",
    "build": "vite build",
    "preview": "vite preview",
    "weekly-curator": "node scripts/weekly-curator.js",
    "streak-pool": "node scripts/streak-pool-builder.js",
    "streak-rotation": "node scripts/streak-rotation-generator.js",
    "streak-refresh": "node scripts/streak-pool-builder.js && node scripts/streak-rotation-generator.js",
    "streak-pool:ingest": "node scripts/streak-pool-ingest.mjs",
    "build:streak-sample": "node scripts/generate-sample-streak-pool.mjs",
    "build:streak-statcast": "node scripts/build-streak-pool-from-statcast.mjs",
    "supabase:migrate": "node scripts/supabase-migrate.mjs",
    "vercel:env": "node scripts/vercel-env-setup.mjs",
    "vercel:supabase": "node scripts/vercel-supabase-connect.mjs",
    "connect:prod": "node scripts/connect-production.mjs",
    "audit-handedness": "node scripts/audit-handedness.js",
    "test": "node scratch/run_headless.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/vite": "^4.3.0",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  }
}
